theme = Seti

# Monaspace Neon — neo-grotesque sans, the "default" of the Monaspace family
# Italic uses Monaspace Radon (handwriting) for a designed-italic look that's
# clearly different from the upright text. Remove font-family-italic if you'd
# rather have plain slanted Neon italics.
font-family = Monaspace Neon
font-family-italic = Monaspace Radon
font-family-bold-italic = Monaspace Radon
font-size = 14

# calt   = contextual alternates → enables Monaspace's "texture healing"
# liga   = standard ligatures (==, =>, !=, ->, etc.)
# ss01–ss08 = stylistic sets (alt forms for arrows, comparisons, etc.)
font-feature = calt
font-feature = liga
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss05
font-feature = ss06
font-feature = ss07
font-feature = ss08
