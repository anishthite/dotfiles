theme = Seti

# Match Alacritty's terminal faces.
font-family = BerkeleyMono Nerd Font
font-family-bold = BerkeleyMono Nerd Font
font-family-italic = Monaspace Radon
font-family-bold-italic = Monaspace Radon
font-style-bold = Medium
font-style-italic = Italic
font-style-bold-italic = Bold Italic
font-size = 14

# Match Alacritty's Shift+Return escape sequence.
keybind = shift+enter=text:\x1b\r

# calt   = contextual alternates → enables Monaspace's "texture healing"
# liga   = standard ligatures (==, =>, !=, ->, etc.)
# ss01–ss08 = stylistic sets (alt forms for arrows, comparisons, etc.)
font-feature = calt
font-feature = liga
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss05
font-feature = ss06
font-feature = ss07
font-feature = ss08
